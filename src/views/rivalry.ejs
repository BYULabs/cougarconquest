<%- include('partials/header') %>

<main class="bg-[#001528] text-gray-100 min-h-screen overflow-x-hidden pt-16 sm:pt-20">

  <!-- ====== RIVALRY HERO ====== -->
  <section class="relative overflow-hidden pt-6 sm:pt-12 pb-8">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-0 left-1/4 w-72 sm:w-96 h-72 sm:h-96 bg-byuRoyal/15 rounded-full blur-3xl"></div>
      <div class="absolute top-10 right-1/4 w-60 sm:w-80 h-60 sm:h-80 bg-red-500/10 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Navigation & Badge Row -->
      <div class="flex items-center justify-between mb-4 sm:mb-6">
        <a href="/" class="inline-flex items-center gap-2 text-xs font-bold text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 px-3.5 py-1.5 rounded-full transition">
          <i class="fas fa-arrow-left text-[10px]"></i> Back to Conquest Grid
        </a>
        
        <span class="inline-flex items-center gap-1.5 text-amber-400 font-bold text-[10px] sm:text-xs tracking-[0.2em] uppercase bg-white/5 border border-white/10 px-3 py-1 rounded-full">
          <i class="fas fa-trophy text-xs"></i> Head-To-Head Record
        </span>
      </div>

      <!-- Hero Matchup Card -->
      <div class="hero-card max-w-5xl mx-auto bg-gradient-to-br from-[#00375E]/90 to-byuNavy/60 border border-white/10 rounded-3xl p-4 sm:p-8 shadow-2xl backdrop-blur-md relative overflow-hidden">
        
        <h1 class="relative text-center text-2xl sm:text-5xl font-black text-white tracking-tight mb-1 uppercase">
          BYU <span class="text-amber-400">vs</span> <%= opponent %>
        </h1>
        <p class="relative text-center text-gray-400 text-xs sm:text-base mb-6 sm:mb-8">All-Time Conquest History Breakdown</p>

        <!-- Teams & Record Bar -->
        <div class="relative grid grid-cols-3 items-center gap-2 sm:gap-6 text-center">
          
          <!-- BYU -->
          <div class="flex flex-col items-center min-w-0">
            <div class="animate-float w-16 h-16 sm:w-28 sm:h-28 rounded-full bg-gradient-to-br from-byuRoyal to-byuNavy flex items-center justify-center shadow-xl border-2 sm:border-4 border-white/10 p-2 sm:p-3 transition transform hover:scale-105">
              <img src="<%= byuLogo %>" alt="BYU" class="w-full h-full object-contain">
            </div>
            <div class="text-sm sm:text-2xl font-black text-white mt-2 truncate w-full">BYU</div>
            <div class="text-[9px] sm:text-xs text-gray-400 uppercase tracking-wide font-semibold">Cougars</div>
          </div>

          <!-- VS / Overall Record -->
          <div class="flex flex-col items-center justify-center min-w-0">
            <div class="w-9 h-9 sm:w-14 sm:h-14 rounded-full bg-white/5 border border-white/10 flex items-center justify-center mb-2">
              <i class="fas fa-swords text-xs sm:text-xl text-amber-400"></i>
            </div>
            
            <div class="flex items-center justify-center gap-1 sm:gap-2 text-base sm:text-3xl font-black">
              <span class="text-green-400"><%= stats.byuWins %></span>
              <span class="text-gray-500 text-xs sm:text-lg">-</span>
              <span class="text-red-400"><%= stats.opponentWins %></span>
              <% if (stats.ties > 0) { %>
                <span class="text-gray-500 text-xs sm:text-lg">-</span>
                <span class="text-gray-400"><%= stats.ties %></span>
              <% } %>
            </div>
            
            <div class="text-[9px] sm:text-xs text-gray-400 uppercase tracking-widest font-bold mt-0.5">
              Series Record
            </div>
          </div>

          <!-- Opponent -->
          <div class="flex flex-col items-center min-w-0">
            <div class="animate-float w-16 h-16 sm:w-28 sm:h-28 rounded-full bg-white/5 flex items-center justify-center shadow-xl border-2 sm:border-4 border-white/10 p-2 sm:p-3 transition transform hover:scale-105">
              <img src="<%= opponentLogo %>" alt="<%= opponent %>" class="w-full h-full object-contain">
            </div>
            <div class="text-sm sm:text-2xl font-black text-white mt-2 truncate w-full"><%= opponent %></div>
            <div class="text-[9px] sm:text-xs text-gray-400 uppercase tracking-wide font-semibold">Opponent</div>
          </div>

        </div>

        <!-- Quick Facts Bar -->
        <div class="relative mt-6 pt-5 border-t border-white/10 grid grid-cols-3 gap-2 text-center">
          <div class="stat-card bg-white/5 rounded-xl p-2 sm:p-3 border border-white/5">
            <div class="text-lg sm:text-2xl font-black text-white"><%= stats.totalGames %></div>
            <div class="text-[9px] sm:text-[10px] text-gray-400 uppercase tracking-wide font-semibold">Games Played</div>
          </div>
          <div class="stat-card bg-white/5 rounded-xl p-2 sm:p-3 border border-white/5">
            <div class="text-lg sm:text-2xl font-black text-green-400"><%= stats.byuWins %></div>
            <div class="text-[9px] sm:text-[10px] text-gray-400 uppercase tracking-wide font-semibold">BYU Wins</div>
          </div>
          <div class="stat-card bg-white/5 rounded-xl p-2 sm:p-3 border border-white/5">
            <div class="text-lg sm:text-2xl font-black text-amber-400"><%= stats.byuAvgPts %></div>
            <div class="text-[9px] sm:text-[10px] text-gray-400 uppercase tracking-wide font-semibold">Avg BYU Pts</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== ALL-TIME SERIES BREAKDOWN ====== -->
  <section class="py-8 sm:py-12 bg-gradient-to-b from-transparent to-byuNavy/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-6">
        <h2 class="text-xl sm:text-3xl font-black text-white mb-1">Series Breakdown</h2>
        <p class="text-gray-400 text-xs sm:text-sm">Historical win ratios &amp; scoring totals</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4 sm:gap-6">
        
        <!-- Win Share Conic Pie -->
        <div class="stat-card bg-gradient-to-br from-[#00375E]/70 to-byuNavy/40 border border-white/10 rounded-2xl p-5 text-center flex flex-col justify-center">
          <h3 class="font-bold text-white text-xs sm:text-sm mb-4 uppercase tracking-wider">Win Share</h3>
          
          <div class="relative w-32 h-32 sm:w-40 sm:h-40 mx-auto mb-4">
            <div class="absolute inset-0 rounded-full shadow-lg" style="background: conic-gradient(#0062B8 0% <%= stats.byuWinPct %>%, #CC0000 <%= stats.byuWinPct %>% <%= stats.byuWinPct + stats.oppWinPct %>%, #4B5563 <%= stats.byuWinPct + stats.oppWinPct %>% 100%);"></div>
            <div class="absolute inset-3 rounded-full bg-[#001528] flex flex-col items-center justify-center">
              <span class="text-2xl sm:text-3xl font-black text-white"><%= stats.totalGames %></span>
              <span class="text-[9px] sm:text-[10px] text-gray-400 uppercase tracking-wider">Total</span>
            </div>
          </div>

          <div class="flex items-center justify-center gap-3 sm:gap-4 text-xs flex-wrap">
            <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-byuRoyal"></span><span class="text-gray-300">BYU <%= stats.byuWinPct %>%</span></div>
            <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-red-600"></span><span class="text-gray-300"><%= opponent %> <%= stats.oppWinPct %>%</span></div>
            <% if (stats.tiePct > 0) { %>
              <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-gray-600"></span><span class="text-gray-300">Tie <%= stats.tiePct %>%</span></div>
            <% } %>
          </div>
        </div>

        <!-- Scoring Metrics -->
        <div class="stat-card bg-gradient-to-br from-[#00375E]/70 to-byuNavy/40 border border-white/10 rounded-2xl p-5 flex flex-col justify-between">
          <h3 class="font-bold text-white text-xs sm:text-sm mb-4 uppercase tracking-wider text-center">Scoring Totals</h3>
          
          <div class="grid grid-cols-2 gap-3 text-center mb-4">
            <div class="bg-white/5 p-3 rounded-xl border border-white/5">
              <div class="text-2xl sm:text-3xl font-black text-byuRoyal"><%= stats.byuTotalPts %></div>
              <div class="text-[9px] sm:text-[10px] text-gray-400 uppercase font-semibold mt-1">BYU Points</div>
            </div>
            <div class="bg-white/5 p-3 rounded-xl border border-white/5">
              <div class="text-2xl sm:text-3xl font-black text-red-500"><%= stats.oppTotalPts %></div>
              <div class="text-[9px] sm:text-[10px] text-gray-400 uppercase font-semibold mt-1"><%= opponent %> Pts</div>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 text-center border-t border-white/10 pt-3">
            <div>
              <div class="text-lg font-black text-amber-400"><%= stats.byuAvgPts %></div>
              <div class="text-[9px] text-gray-400 uppercase">Avg BYU Pts</div>
            </div>
            <div>
              <div class="text-lg font-black text-amber-400"><%= stats.oppAvgPts %></div>
              <div class="text-[9px] text-gray-400 uppercase">Avg <%= opponent %> Pts</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== RECENT MEETINGS ====== -->
  <section class="py-8 sm:py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
        <div>
          <h2 class="text-xl sm:text-3xl font-black text-white">Recent Meetings</h2>
          <p class="text-gray-400 text-xs sm:text-sm">Last <%= recentGames.length %> games in series history</p>
        </div>
        <div class="flex items-center gap-3 text-[10px] sm:text-xs">
          <div class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-green-500"></span><span class="text-gray-400">BYU Win</span></div>
          <div class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-red-500"></span><span class="text-gray-400"><%= opponent %> Win</span></div>
        </div>
      </div>

      <div class="space-y-2.5">
        <% if (recentGames && recentGames.length > 0) { %>
          <% recentGames.forEach(g => { %>
            <% const byuWon = g.winner === 'byu'; %>
            
            <div class="game-row bg-gradient-to-r from-[#00375E]/60 to-byuNavy/40 border border-white/10 rounded-xl p-3.5 sm:px-5 sm:py-3 flex items-center justify-between gap-3 <%= byuWon ? 'border-l-4 border-l-green-500' : 'border-l-4 border-l-red-500' %>">
              
              <div class="flex flex-col min-w-0">
                <span class="text-xs sm:text-sm font-bold text-white"><%= g.date %></span>
                <span class="text-[10px] sm:text-xs text-gray-400 truncate max-w-[120px] sm:max-w-xs"><%= g.location %></span>
              </div>

              <div class="flex items-center gap-2 text-xs sm:text-sm font-black">
                <span class="<%= byuWon ? 'text-green-400' : 'text-gray-400' %>">BYU <%= g.byuScore %></span>
                <span class="text-gray-600 text-xs">—</span>
                <span class="<%= !byuWon ? 'text-red-400' : 'text-gray-400' %>"><%= g.oppScore %> <%= opponent.substring(0, 4).toUpperCase() %></span>
              </div>

              <div class="shrink-0 text-right">
                <% if (byuWon) { %>
                  <span class="inline-flex items-center gap-1 bg-green-500/10 border border-green-500/20 text-green-400 font-bold text-[10px] sm:text-xs px-2 py-0.5 rounded-full">
                    <i class="fas fa-check text-[8px]"></i> BYU
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 bg-red-500/10 border border-red-500/20 text-red-400 font-bold text-[10px] sm:text-xs px-2 py-0.5 rounded-full">
                    <i class="fas fa-check text-[8px]"></i> <%= opponent.substring(0, 5) %>
                  </span>
                <% } %>
              </div>

            </div>
          <% }) %>
        <% } else { %>
          <div class="p-6 bg-white/5 rounded-xl text-center text-gray-400 text-xs sm:text-sm">No matchup history available.</div>
        <% } %>
      </div>

    </div>
  </section>

</main>

<%- include('partials/footer') %>