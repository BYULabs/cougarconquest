<%- include('partials/header') %>

<!-- ====== DYNAMIC LIVE NEWS TICKER ====== -->
<div class="bg-byuNavy border-b border-white/10 py-2 overflow-hidden whitespace-nowrap flex items-center pt-16 sm:pt-20 relative">
  
  <!-- Solid Background Container to Block Scrolling Text -->
  <div class="bg-byuNavy z-10 pl-4 pr-3 py-1 flex items-center shrink-0">
    <span class="bg-amber-400 text-byuNavy font-black text-[10px] px-2.5 py-0.5 rounded-full uppercase flex items-center gap-1 shadow-md">
      <i class="fas fa-bolt text-[9px] animate-tick"></i> Schedule Feed
    </span>
  </div>

  <!-- Scrolling Marquee Text Container -->
  <div class="overflow-hidden w-full">
    <div class="inline-flex gap-8 animate-marquee text-xs font-semibold text-gray-300">
      <% if (typeof tickerItems !== 'undefined' && tickerItems.length > 0) { %>
        <% for (let i = 0; i < 3; i++) { %>
          <% tickerItems.forEach(item => { %>
            <span><%= item %></span>
          <% }) %>
        <% } %>
      <% } else { %>
        <span>🏈 Cougar Conquest — BYU Football Schedule &amp; Rivalry Tracking</span>
        <span>🏈 Cougar Conquest — BYU Football Schedule &amp; Rivalry Tracking</span>
        <span>🏈 Cougar Conquest — BYU Football Schedule &amp; Rivalry Tracking</span>
        <span>🏈 Cougar Conquest — BYU Football Schedule &amp; Rivalry Tracking</span>
      <% } %>
    </div>
  </div>
</div>

<main>
  <!-- ====== HERO MODULE ====== -->
  <section id="next-matchup" class="relative overflow-hidden py-8 sm:py-16">
    <!-- Subtle Background Accents -->
    <div class="absolute inset-0 bg-gradient-to-b from-byuNavy/40 via-transparent to-transparent"></div>
    <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-[280px] sm:w-[500px] h-[280px] sm:h-[500px] bg-byuRoyal/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Week Badge -->
      <div class="text-center mb-4 sm:mb-6">
        <span class="inline-flex items-center gap-2 bg-white/5 border border-white/10 px-3.5 py-1.5 rounded-full text-byuRoyal font-bold text-xs tracking-widest uppercase">
          <i class="fas fa-football text-amber-400 animate-tick"></i> 
          <%= nextGame ? 'Game Week ' + nextGame.week : 'Next Game' %>
        </span>
      </div>

      <!-- Main Hero Matchup Card -->
      <div class="hero-card max-w-3xl mx-auto bg-gradient-to-br from-[#00375E]/90 to-byuNavy/70 border border-white/10 rounded-3xl p-5 sm:p-8 shadow-2xl backdrop-blur-md relative overflow-hidden">
        
        <!-- Matchup Row -->
        <div class="grid grid-cols-3 items-center gap-2 sm:gap-6 text-center">
          
          <!-- BYU Side -->
          <div class="flex flex-col items-center">
            <div class="animate-float w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-gradient-to-br from-byuRoyal to-byuNavy flex items-center justify-center shadow-xl border-2 sm:border-4 border-white/20 p-2 transition transform hover:scale-105">
              <img 
                src="<%= (nextGame && nextGame.byuLogo) ? nextGame.byuLogo : 'https://ssl.gstatic.com/onebox/media/sports/logos/optimized/hxz7taoji58jiIwg5XOu9A_120x120.png' %>" 
                alt="BYU" 
                class="w-full h-full object-contain"
              >
            </div>
            <h2 class="text-xl sm:text-3xl font-black text-white tracking-tight mt-2 sm:mt-3">BYU</h2>
            <span class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-widest font-semibold">Cougars</span>
          </div>

          <!-- VS Divider Center -->
          <div class="flex flex-col items-center justify-center">
            <div class="w-10 h-10 sm:w-14 sm:h-14 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shadow-inner">
              <i class="fas fa-football text-base sm:text-2xl text-amber-400"></i>
            </div>
            <span class="text-xs sm:text-sm font-black text-gray-400 tracking-widest mt-1.5">VS</span>
          </div>

          <!-- Opponent Side -->
          <div class="flex flex-col items-center">
            <div class="animate-float w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-white/5 flex items-center justify-center shadow-xl border-2 sm:border-4 border-white/20 p-2 transition transform hover:scale-105">
              <% if (nextGame && nextGame.opponentLogo) { %>
                <img src="<%= nextGame.opponentLogo %>" alt="<%= nextGame.opponent %>" class="w-full h-full object-contain">
              <% } else { %>
                <span class="text-lg sm:text-2xl font-black text-white tracking-tight">
                  <%= nextGame ? nextGame.opponent.substring(0, 3).toUpperCase() : 'OPP' %>
                </span>
              <% } %>
            </div>
            <h2 class="text-xl sm:text-3xl font-black text-white tracking-tight mt-2 sm:mt-3 truncate max-w-[100px] sm:max-w-none">
              <%= nextGame ? nextGame.opponent : 'Opponent' %>
            </h2>
            <span class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-widest font-semibold">Rival</span>
          </div>

        </div>

        <!-- Kickoff Countdown Timer Bar -->
        <div class="mt-6 pt-4 border-t border-white/10">
          <p class="text-[10px] text-gray-400 uppercase tracking-widest text-center font-bold mb-2">Countdown To Kickoff</p>
          <div id="gameCountdown" 
              data-start-date="<%= (nextGame && nextGame.startDate) ? nextGame.startDate : '' %>" 
              class="flex justify-center gap-2 sm:gap-4">
            <div class="bg-white/5 border border-white/10 rounded-xl px-3 py-1.5 text-center min-w-[55px]">
              <span id="cd-days" class="block text-base sm:text-xl font-black text-amber-400">00</span>
              <span class="text-[9px] text-gray-400 uppercase font-bold">Days</span>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl px-3 py-1.5 text-center min-w-[55px]">
              <span id="cd-hours" class="block text-base sm:text-xl font-black text-white">00</span>
              <span class="text-[9px] text-gray-400 uppercase font-bold">Hrs</span>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-xl px-3 py-1.5 text-center min-w-[55px]">
              <span id="cd-mins" class="block text-base sm:text-xl font-black text-white">00</span>
              <span class="text-[9px] text-gray-400 uppercase font-bold">Min</span>
            </div>
          </div>
        </div>

        <!-- Action Button -->
        <div class="mt-6 flex items-center justify-center gap-3">
          <% if (nextGame && nextGame.opponent) { %>
            <a href="/vs/<%= nextGame.opponent.toLowerCase().replace(/\s+/g, '-') %>" class="flex-1 sm:flex-none flex items-center justify-center gap-2 bg-byuRoyal hover:bg-byuRoyal/80 text-white font-bold text-xs sm:text-sm px-6 py-3 rounded-xl transition shadow-lg text-center">
              <i class="fas fa-chart-bar text-xs"></i>
              <span>View Rivalry Breakdown</span>
            </a>
          <% } else { %>
            <a href="#schedule" class="flex-1 sm:flex-none flex items-center justify-center gap-2 bg-byuRoyal hover:bg-byuRoyal/80 text-white font-bold text-xs sm:text-sm px-6 py-3 rounded-xl transition shadow-lg text-center">
              <i class="fas fa-calendar-alt text-xs"></i>
              <span>Explore Season Schedule</span>
            </a>
          <% } %>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== QUICK STATS BAR ====== -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-2 relative z-10">
    <div class="grid grid-cols-3 gap-3 sm:gap-6">
      <div class="stat-card bg-gradient-to-br from-byuNavy/60 to-[#00375E]/40 border border-white/10 rounded-2xl p-4 text-center">
        <div class="text-2xl sm:text-3xl font-black text-white"><%= schedule ? schedule.length : 12 %></div>
        <div class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wide font-semibold mt-1">Games Scheduled</div>
      </div>
      <div class="stat-card bg-gradient-to-br from-byuNavy/60 to-[#00375E]/40 border border-white/10 rounded-2xl p-4 text-center">
        <div class="text-2xl sm:text-3xl font-black text-amber-400">Week <%= nextGame ? nextGame.week : '1' %></div>
        <div class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wide font-semibold mt-1">Current Game</div>
      </div>
      <div class="stat-card bg-gradient-to-br from-byuNavy/60 to-[#00375E]/40 border border-white/10 rounded-2xl p-4 text-center">
        <div class="text-2xl sm:text-3xl font-black text-white">9</div>
        <div class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wide font-semibold mt-1">Big 12 Matchups</div>
      </div>
    </div>
  </div>

  <!-- ====== RIVALRY & CONQUEST ====== -->
  <section class="py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h2 class="text-2xl sm:text-3xl font-black text-white mb-1">Road to Conquest</h2>
        <p class="text-gray-400 text-sm">Preview upcoming matchups and dive into historical rivalry stats.</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-6 items-start">

        <!-- LEFT COLUMN: Upcoming Battles (Next 4 Games) -->
        <div id="battles" class="bg-gradient-to-br from-[#00375E]/70 to-byuNavy/40 border border-white/10 rounded-2xl p-6">
          <div class="flex items-center justify-between mb-5 group">
            <h3 class="text-lg font-black text-white flex items-center gap-2">
              <i class="fas fa-swords text-amber-400 transition-transform duration-200"></i> Upcoming Battles
            </h3>
            <span class="text-xs text-byuRoyal font-bold uppercase tracking-wider">Next 4 Games</span>
          </div>

          <% 
            const upcomingGames = schedule ? schedule.filter(g => !g.completed).slice(0, 4) : []; 
          %>

          <div class="space-y-3">
            <% if (upcomingGames.length > 0) { %>
              <% upcomingGames.forEach(game => { %>
                <a href="/vs/<%= game.opponent.toLowerCase().replace(/\s+/g, '-') %>" class="battle-card flex items-center justify-between bg-white/5 border border-white/10 rounded-xl p-3.5 group hover:bg-white/10 transition">
                  
                  <!-- Game Info & Logos -->
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-byuNavy flex items-center justify-center border border-white/10 p-1.5 shrink-0 shadow-md group-hover:rotate-6 transition-transform">
                      <img src="<%= game.opponentLogo %>" alt="<%= game.opponent %>" class="w-full h-full object-contain">
                    </div>
                    
                    <div>
                      <div class="flex items-center gap-2">
                        <span class="text-sm font-black text-white group-hover:text-byuRoyal transition"><%= game.opponent %></span>
                        <span class="text-[10px] bg-white/10 text-gray-300 px-1.5 py-0.5 rounded font-semibold uppercase">
                          <%= game.isHome ? 'Home' : 'Away' %>
                        </span>
                      </div>
                      <div class="text-xs text-gray-400 mt-0.5">
                        Week <%= game.week %> • <%= game.startDate ? new Date(game.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'Date TBD' %>
                      </div>
                    </div>
                  </div>

                  <!-- CTA Arrow -->
                  <div class="flex items-center gap-2 text-xs text-gray-400 group-hover:text-byuRoyal font-bold transition shrink-0">
                    <span class="hidden sm:inline">Rivalry Stats</span>
                    <i class="fas fa-chevron-right text-xs group-hover:translate-x-1.5 transition-transform"></i>
                  </div>
                </a>
              <% }) %>
            <% } else { %>
              <div class="text-center py-6 text-gray-400 text-sm">No upcoming games remaining on this schedule.</div>
            <% } %>
          </div>
        </div>

        <!-- RIGHT COLUMN: Full Season Conquest Grid -->
        <div id="schedule" class="bg-gradient-to-br from-[#00375E]/70 to-byuNavy/40 border border-white/10 rounded-2xl p-6">
          <div class="flex items-center justify-between mb-5">
            <div>
              <h3 class="text-lg font-black text-white flex items-center gap-2">
                <i class="fas fa-trophy text-amber-400"></i> <%= typeof year !== 'undefined' ? year : '2026' %> Schedule Grid
              </h3>
              <p class="text-xs text-gray-400 mt-0.5">Click any team to view full head-to-head records</p>
            </div>
          </div>

          <div id="conquestGrid" class="grid grid-cols-3 sm:grid-cols-4 gap-3">
            <% if (typeof schedule !== 'undefined' && schedule.length > 0) { %>
              <% schedule.forEach(game => { %>
                <a href="/vs/<%= game.opponent.toLowerCase().replace(/\s+/g, '-') %>" class="grid-card relative bg-white/5 border border-white/10 rounded-xl p-3 flex flex-col items-center gap-2 group hover:bg-white/10 transition">
                  <div class="w-10 h-10 rounded-full flex items-center justify-center font-black text-white text-[10px] shadow-lg border border-white/10 bg-byuNavy group-hover:scale-110 transition-transform">
                    <img src="<%= game.opponentLogo %>" class="w-6 h-6 object-contain" alt="<%= game.opponent %>">
                  </div>
                  <span class="text-[10px] text-gray-400 group-hover:text-white font-medium text-center leading-tight truncate w-full transition-colors"><%= game.opponent %></span>
                  
                  <% if (game.completed) { %>
                    <div class="status-badge absolute -top-1 -right-1 w-5 h-5 bg-green-500 rounded-full flex items-center justify-center border-2 border-[#001528]">
                      <i class="fas fa-check text-white text-[8px]"></i>
                    </div>
                  <% } else { %>
                    <div class="absolute -top-1 -right-1 w-5 h-5 bg-gray-700 rounded-full flex items-center justify-center border-2 border-[#001528]">
                      <i class="fas fa-clock text-gray-400 text-[8px]"></i>
                    </div>
                  <% } %>
                </a>
              <% }) %>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>