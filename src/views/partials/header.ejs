<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Cougar Conquest | BYU Football Portal' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            byuNavy: '#002E5D',
            byuRoyal: '#0062B8',
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
        },
      },
    };
  </script>
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="bg-[#001528] text-gray-100 min-h-screen overflow-x-hidden">

  <!-- ====== NAVBAR ====== -->
  <nav id="mainNavbar" class="fixed top-0 left-0 right-0 z-50 bg-byuNavy/95 backdrop-blur-md border-b border-white/10 shadow-lg transition-transform duration-300 ease-in-out">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 gap-4">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-3 shrink-0">
          <div class="relative w-10 h-10 rounded-full bg-gradient-to-br from-byuRoyal to-byuNavy flex items-center justify-center shadow-lg border-2 border-white/20">
            <span class="text-xl font-black text-white leading-none">Y</span>
            <div class="absolute -bottom-1 -right-1 w-4 h-4 bg-amber-400 rounded-full flex items-center justify-center border-2 border-byuNavy">
              <i class="fas fa-trophy text-[7px] text-byuNavy"></i>
            </div>
          </div>
          <div class="leading-none">
            <h1 class="text-lg font-black tracking-tight text-white uppercase">COUGAR <span class="text-byuRoyal">CONQUEST</span></h1>
            <p class="text-[9px] text-gray-400 tracking-[0.18em] uppercase mt-0.5">BYU Football &amp; Rivalries</p>
          </div>
        </a>

        <!-- Search Bar -->
        <div class="hidden md:block flex-1 max-w-md">
          <div class="relative">
            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-sm pointer-events-none"></i>
            <input 
              type="text" 
              id="searchInputDesktop" 
              placeholder="Search opponents or seasons..." 
              class="w-full bg-white/5 border border-white/10 rounded-full pl-11 pr-4 py-2 text-sm text-gray-200 placeholder-gray-500 focus:outline-none focus:border-byuRoyal focus:bg-white/10 transition"
            >
          </div>
        </div>

        <!-- Desktop Navigation Links -->
        <div class="hidden md:flex items-center gap-6">
          <a href="/#next-matchup" class="text-sm font-semibold text-gray-300 hover:text-white transition">Next Game</a>
          <a href="/#battles" class="text-sm font-semibold text-gray-300 hover:text-white transition">Battles</a>
          <a href="/#schedule" class="text-sm font-semibold text-gray-300 hover:text-white transition">Schedule</a>
        </div>

        <!-- Mobile Controls -->
        <div class="flex md:hidden items-center gap-2">
          <button id="searchToggleBtn" type="button" aria-label="Toggle Search" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-gray-300 hover:text-white transition focus:outline-none">
            <i class="fas fa-search text-sm"></i>
          </button>
          <button id="menuToggleBtn" type="button" aria-label="Toggle Navigation Menu" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-gray-300 hover:text-white transition focus:outline-none">
            <i id="menuIcon" class="fas fa-bars text-base"></i>
          </button>
        </div>

      </div>
    </div>

    <!-- Mobile Collapsible Search Sub-Bar -->
    <div id="mobileSearchSubbar" class="hidden md:hidden border-t border-white/10 bg-[#001528]/95 px-4 py-3">
      <div class="relative">
        <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-sm pointer-events-none"></i>
        <input 
          type="text" 
          id="searchInputMobile" 
          placeholder="Search opponents or seasons..." 
          class="w-full bg-white/5 border border-white/10 rounded-full pl-11 pr-4 py-2 text-sm text-gray-200 placeholder-gray-500 focus:outline-none focus:border-byuRoyal"
        >
      </div>
    </div>

    <!-- Mobile Navigation Dropdown -->
    <div id="mobileMenu" class="hidden md:hidden border-t border-white/10 bg-[#001528]/95 px-4 pt-3 pb-6 space-y-2">
      <a href="/" class="block px-3 py-2 rounded-lg text-base font-medium text-gray-200 hover:text-white hover:bg-white/10 transition">Home Portal</a>
      <a href="/#next-matchup" class="block px-3 py-2 rounded-lg text-base font-medium text-gray-200 hover:text-white hover:bg-white/10 transition">Next Game</a>
      <a href="/#battles" class="block px-3 py-2 rounded-lg text-base font-medium text-gray-200 hover:text-white hover:bg-white/10 transition">Upcoming Battles</a>
      <a href="/#schedule" class="block px-3 py-2 rounded-lg text-base font-medium text-gray-200 hover:text-white hover:bg-white/10 transition">Schedule Grid</a>
    </div>
  </nav>